<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunAnalyzersDuringBuild>False</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <UseSharedCompilation>true</UseSharedCompilation>
    <EnableNodeApiGenerator Condition="'$(EnableNodeApiGenerator)' == ''">false</EnableNodeApiGenerator>
    <GenerateNodeApiTypeDefinitions>false</GenerateNodeApiTypeDefinitions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Iconic.Zlib.Netstandard" Version="1.0.0" />
    <PackageReference Include="ini-parser-netstandard" Version="2.5.2" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.2.16" />
    <PackageReference Include="Microsoft.JavaScript.NodeApi" Version="0.9.27" />
    <!-- Dynamic node-api-dotnet loading is the cross-platform default. Enable
         this explicitly when producing the legacy generated JS export surface. -->
    <PackageReference Include="Microsoft.JavaScript.NodeApi.Generator" Version="0.9.27" PrivateAssets="all" Condition="'$(EnableNodeApiGenerator)' == 'true'" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\balsa\balsa\balsa.csproj" />
  </ItemGroup>

</Project>
