# Copy this file to .env and point the entries at your local game installs.
# Values here are only defaults: real environment variables always take
# precedence over .env entries.
#
# Each entry is a game Data folder containing that game's .esm files.
# Tests fall back to fixtures/<name>.esm (git-ignored local copies) when
# a variable is unset or the file is not found there.
ESPER_TES4_DATA=
ESPER_FO3_DATA=
ESPER_FNV_DATA=
ESPER_TES5_DATA=
ESPER_SSE_DATA=
ESPER_FO4_DATA=
ESPER_SF_DATA=
# Test mode: fixture (default), game, or build. See README.md.
# ESPER_TEST_MODE=fixture
